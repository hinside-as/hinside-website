---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioCarousel, { type PortfolioItem } from "../../components/carousel/PortfolioCarousel.tsx";
import LogoCarousel from "../../components/carousel/LogoCarousel.tsx";
import AsciiLogo from "../../components/AsciiLogo.tsx";
import ContactForm from "../../components/ContactForm.tsx";
import { getMediaImage } from "../../lib/media";
import { getImage } from "astro:assets";
import { locales, useTranslations, localizedPath, type Locale } from "../../i18n/utils";
import { clients } from "../../data/clients";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const caseStudies = (await getCollection("case-studies")).filter(
  (entry) => entry.data.featured,
);

const portfolioItems: PortfolioItem[] = await Promise.all(
  caseStudies.map(async (entry) => {
    const optimized = await getImage({
      src: getMediaImage(entry.data.cover),
      width: 800,
    });
    return {
      href: localizedPath(locale, `/work/${entry.id}`),
      title: entry.data.title[locale],
      subtitle: entry.data.dek[locale],
      image: optimized.src,
      imageAlt: entry.data.coverAlt[locale],
      accent: entry.data.accent,
    };
  }),
);

const clientItems = clients.map((client) => ({
  src: client.logo,
  alt: client.name,
  href: client.href,
  height: client.height,
}));

const testimonials = await getCollection("testimonials");

const formLabels = {
  name: t("form.name"),
  namePlaceholder: t("form.namePlaceholder"),
  email: t("form.email"),
  emailPlaceholder: t("form.emailPlaceholder"),
  subject: t("form.subject"),
  subjectPlaceholder: t("form.subjectPlaceholder"),
  message: t("form.message"),
  messagePlaceholder: t("form.messagePlaceholder"),
  submit: t("form.submit"),
  note: t("form.note"),
  success: t("form.success"),
  error: t("form.error"),
};

---

<BaseLayout
  locale={locale}
  title="hinside — design & development studio"
  description={t("home.hero.eyebrow")}
>
  <section class="band band--bg">
    <div class="section-inner hero">
      <h1 class="hero__headline" data-reveal data-parallax="0.08">
        {locale === "no"
          ? "Design er problemløsning, ikke dekorasjon — med mindre dekorasjonen løser et problem."
          : "Design is solving problems, not decoration — unless decoration solves a problem."}
      </h1>
      <p class="hero__dek" data-reveal data-parallax="0.16">
        {locale === "no"
          ? "Hinside jobber med merkevareidentitet, digitale produkter, print, verktøy, arrangementer og skilting — der et problem trenger et visuelt eller systemisk svar. Hvert prosjekt starter med nysgjerrighet og ender med noe metodisk: bygget for å fungere, ikke bare for å se bra ut."
          : "Hinside works across brand identity, digital products, print, tools, events, and signage — wherever a problem needs a visual or systemic answer. Every project starts with curiosity and ends with something methodical: built to work, not just to look good."}
      </p>
    </div>
  </section>

  <section class="band band--bg">
    <div class="section-inner ascii-logo-section">
      <AsciiLogo client:visible />
    </div>
  </section>

  <section id="work" class="work">
    <div class="work__heading-wrap">
      <h2 class="work__heading" data-reveal>{t("home.work.heading")}</h2>
      <p class="work__intro" data-reveal>
        {locale === "no"
          ? "Et utvalg prosjekter der et problem har fått et visuelt eller systemisk svar."
          : "A selection of projects where a problem found a visual or systemic answer."}
      </p>
    </div>
    <PortfolioCarousel items={portfolioItems} client:visible />
  </section>

  <section id="studio" class="band band--raised">
    <div class="section-inner studio">
      <h2 data-reveal>{t("nav.studio")}</h2>
      <p class="studio__paragraph" data-reveal>
        {locale === "no"
          ? "Hinsides tilnærming ble formet lenge før den fikk et navn — det startet bak disken i en skiltbutikk, med å skjære logoer og bokstaver for hånd, og ble skjerpet gjennom et av Norges mest selektive kreative studieprogrammer og et legendarisk studentdrevet studio bygget på ambisjon fremfor fakturering. Derfra: helhetlig merkevarebygging for noen av Norges sterkeste navn, mindre studioer, frilansarbeid, og ledelse av design i et voksende teknologiselskap. Ulike rom, ulike innsatser, samme instinkt — å behandle design som et verktøy for å løse noe reelt."
          : "Hinside's approach was shaped long before it had a name — starting behind the counter of a sign shop, cutting logos and lettering by hand, then sharpening through one of Norway's most selective creative programs and a legendary student-run studio built on ambition over invoicing. From there: full-service branding for some of Norway's strongest names, smaller studios, freelance work, and leading design inside a growing tech company. Different rooms, different stakes, same instinct — treat design as a tool for solving something real."}
      </p>

      <div class="studio__clients">
        <p class="studio__clients-intro" data-reveal>{t("home.clients.intro")}</p>
        <LogoCarousel items={clientItems} client:visible />
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="band band--bg">
      <div class="section-inner testimonials">
        {testimonials.map((testimonial) => (
          <blockquote class="testimonial" data-reveal>
            <svg class="testimonial__mark" viewBox="0 0 64 32" aria-hidden="true">
              <rect x="4" y="4" width="10" height="10" />
              <rect x="4" y="14" width="10" height="6" />
              <rect x="0" y="20" width="6" height="6" />
              <rect x="30" y="4" width="10" height="10" />
              <rect x="30" y="14" width="10" height="6" />
              <rect x="26" y="20" width="6" height="6" />
            </svg>
            <p>{testimonial.data.quote[locale]}</p>
            <footer>
              <span class="testimonial__name">{testimonial.data.name}</span>
              <span class="testimonial__role">{testimonial.data.role}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </section>
  )}

  <section id="contact" class="band band--raised">
    <div class="section-inner contact">
      <h2 data-reveal>{t("home.contact.title")}</h2>
      <p class="contact__subtitle" data-reveal>{t("home.contact.subtitle")}</p>
      <ContactForm labels={formLabels} client:visible />
    </div>
  </section>
</BaseLayout>

<style>
  /* Full-bleed alternating background bands — the mechanism for "sections
     read as clear chapters" without divider lines: each band spans the
     viewport edge to edge, and consecutive bands alternate --color-bg /
     --color-bg-raised so the seam between them is visible on its own,
     with no border needed. #work keeps its own distinct cinematic
     background (unchanged) since it's the one section meant to dominate. */
  .band {
    width: 100%;
  }
  .band--bg {
    background: var(--color-bg);
  }
  .band--raised {
    background: var(--color-bg-raised);
  }
  .section-inner {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .ascii-logo-section {
    padding-block: var(--space-9);
  }

  /* The carousel is a deliberate full-bleed exception: its cinematic dark
     background and edge fade need to span the viewport, not the content
     column. It's the only section that breaks the grid this way —
     Studio's client-logo carousel deliberately stays inside the content
     column so Work remains the one section that visually dominates. */
  #work {
    width: 100%;
  }
  .work__heading-wrap {
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .work__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }
  .work__intro {
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    max-width: 42ch;
  }

  /* So the sticky header never covers the section you just navigated to —
     same pattern as the case-study anchor menu in [slug].astro. */
  #work,
  #studio,
  #contact {
    scroll-margin-top: calc(var(--header-height) + var(--space-3));
  }

  .hero {
    padding-top: var(--space-10);
    padding-bottom: var(--space-7);
  }
  .hero__headline {
    font-size: var(--text-4xl);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    max-width: 30ch;
  }
  .hero__dek {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
    max-width: 36ch;
  }
  .studio {
    padding-block: var(--space-9);
  }
  .studio h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }
  .studio__paragraph {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    max-width: 56ch;
  }
  .studio__clients {
    margin-top: var(--space-7);
  }
  .studio__clients-intro {
    max-width: 34rem;
    margin: 0 0 var(--space-7);
    font-size: var(--text-lg);
    color: var(--color-fg-muted);
  }

  /* A single quote reads as a thin repeat of Studio's own column layout —
     centering it as a quiet, generous interlude gives it a distinct
     rhythm instead, and holds up the same way once a second quote exists. */
  .testimonials {
    padding-block: var(--space-9);
    display: flex;
    justify-content: center;
  }
  .testimonial {
    margin: 0;
    /* Matches ContactForm.tsx's own max-width, so the two narrow-column
       moments on the page (this and the contact form) read as the same
       width — the block stays centered on the page (.testimonials above),
       but the text within it is left-justified, not centered. */
    max-width: 32rem;
    text-align: left;
  }
  .testimonial__mark {
    width: 2rem;
    height: 1rem;
    fill: var(--color-fg-muted);
    margin: 0 0 var(--space-4);
  }
  .testimonial p {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }
  .testimonial footer {
    margin-top: var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--text-sm);
  }
  .testimonial__name {
    color: var(--color-fg);
  }
  .testimonial__role {
    color: var(--color-fg-muted);
  }

  .contact {
    padding-block: var(--space-9);
  }
  .contact h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }
  .contact__subtitle {
    font-size: var(--text-lg);
    max-width: 42ch;
    color: var(--color-fg-muted);
    margin-bottom: var(--space-6);
  }
  /* Note: no font-weight declarations left in this file besides the hero
     headline — everything else inherits body's default var(--weight-thin)
     now, per the site-wide rule that only headings/titles get a heavier
     weight. Confidence should come from size and spacing, not weight. */

  @media (min-width: 60rem) {
    .hero__headline {
      max-width: 26ch;
    }
  }
</style>
