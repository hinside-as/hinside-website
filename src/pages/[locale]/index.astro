---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeExperience from "../../components/HomeExperience.tsx";
import type { PinnedPortfolioItem } from "../../components/carousel/PinnedPortfolioCarousel.tsx";
import { getMediaImage } from "../../lib/media";
import { resolveCaseStudyHeroImage } from "../../lib/caseStudyHero";
import { getImage } from "astro:assets";
import { locales, useTranslations, localizedPath, type Locale } from "../../i18n/utils";
import { clients } from "../../data/clients";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const caseStudies = (await getCollection("case-studies")).filter(
  (entry) => entry.data.featured,
);

const portfolioItems: PinnedPortfolioItem[] = await Promise.all(
  caseStudies.map(async (entry) => {
    const hero = resolveCaseStudyHeroImage(entry, locale);
    const optimized = await getImage({
      src: getMediaImage(hero.src),
      width: 800,
    });
    return {
      href: localizedPath(locale, `/work/${entry.id}`),
      slug: entry.id,
      title: entry.data.title[locale],
      subtitle: entry.data.description[locale],
      image: optimized.src,
      imageAlt: hero.alt,
      accent: entry.data.accent,
    };
  }),
);

// A presentation-level bump for this one carousel, not a change to
// clients.ts's own per-logo heights — those are individually tuned to
// match each mark's original legacy size (see that file's own comment),
// and scaling here keeps that reference intact while still sizing the
// homepage carousel up a step.
const LOGO_SIZE_SCALE = 1.2;
const clientItems = clients.map((client) => ({
  src: client.logo,
  alt: client.name,
  href: client.href,
  height: client.height * LOGO_SIZE_SCALE,
}));

const testimonials = (await getCollection("testimonials")).map((testimonial) => ({
  quote: testimonial.data.quote[locale],
  name: testimonial.data.name,
  role: testimonial.data.role,
}));

const formLabels = {
  email: t("form.email"),
  emailPlaceholder: t("form.emailPlaceholder"),
  message: t("form.message"),
  messagePlaceholder: t("form.messagePlaceholder"),
  submit: t("form.submit"),
  note: t("form.note"),
  success: t("form.success"),
  error: t("form.error"),
};

const heroHeadline =
  locale === "no"
    ? "Design er problemløsning, ikke dekor — med mindre dekor løser problemer"
    : "Design is solving problems, not decoration — unless decoration solves a problem.";
const studioParagraph =
  locale === "no"
    ? "Hinsides tilnærming ble formet lenge før den fikk et navn — det startet bak disken i en skiltbutikk, med å skjære logoer og bokstaver for hånd, og ble skjerpet gjennom et av Norges mest selektive kreative studieprogrammer og et legendarisk studentdrevet studio bygget på ambisjon fremfor fakturering. Derfra: helhetlig merkevarebygging for noen av Norges sterkeste navn, mindre studioer, frilansarbeid, og ledelse av design i et voksende teknologiselskap. Ulike rom, ulike innsatser, samme instinkt — å behandle design som et verktøy for å løse noe reelt."
    : "Hinside's approach was shaped long before it had a name — starting behind the counter of a sign shop, cutting logos and lettering by hand, then sharpening through one of Norway's most selective creative programs and a legendary student-run studio built on ambition over invoicing. From there: full-service branding for some of Norway's strongest names, smaller studios, freelance work, and leading design inside a growing tech company. Different rooms, different stakes, same instinct — treat design as a tool for solving something real.";
---

<BaseLayout
  locale={locale}
  title="Hinside — design & development studio"
  description={t("home.hero.eyebrow")}
  bodyBackground="#ebebeb"
  headerScrollControlsVisibility={false}
  headerWideMargin
  footerNoBorder
  footerWideMargin
>
  <HomeExperience
    client:load
    heroHeadline={heroHeadline}
    identityHeading={t("home.identity.heading")}
    workIntro={t("home.work.intro")}
    workOutro={t("home.work.outro")}
    studioHeading={t("nav.studio")}
    studioParagraph={studioParagraph}
    clientsHeading={t("home.clients.heading")}
    clientsIntro={t("home.clients.intro")}
    contactHeading={t("nav.contact")}
    portfolioItems={portfolioItems}
    clientItems={clientItems}
    testimonials={testimonials}
    formLabels={formLabels}
  />
</BaseLayout>
