---
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CaseStudyExperience, { type CaseStudySlide } from "../../../components/CaseStudyExperience.tsx";
import { getMediaImage } from "../../../lib/media";
import { caseCoverTransitionName } from "../../../lib/viewTransitions";
import { locales, useTranslations, localizedPath, type Locale } from "../../../i18n/utils";

export async function getStaticPaths() {
  const caseStudies = await getCollection("case-studies");
  return locales.flatMap((locale) =>
    caseStudies.map((entry) => ({
      params: { locale, slug: entry.id },
      props: { entry },
    })),
  );
}

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props;
const t = useTranslations(locale);

// Flattens each content section into one or more full-bleed slides: a
// "gallery" section (2+ images) becomes one slide per image, since the new
// scrollytelling template shows exactly one visual per step. Only the first
// slide of a section carries that section's heading/body — there's no
// per-image copy in the schema, and inventing filler text for the rest
// would read worse than leaving them as pure visual beats.
// Media src strings come in two shapes (see CLAUDE.md's media pipeline
// notes): a leading "/" means it's already a public/-relative URL (SVGs,
// videos — served as-is, never processed by astro:assets); anything else is
// a relative path into src/assets/media that needs getMediaImage + getImage.
async function resolveImageSrc(src: string, width = 1920): Promise<string> {
  if (src.startsWith("/")) return src;
  const optimized = await getImage({ src: getMediaImage(src), width });
  return optimized.src;
}

const slides: CaseStudySlide[] = [];
for (const section of entry.data.sections) {
  const heading = section.heading[locale];
  const body = section.body[locale];
  const media = section.media;

  if (!media) {
    slides.push({ chapterId: section.id, heading, body });
    continue;
  }

  if (media.type === "image") {
    const src = await resolveImageSrc(media.src);
    // 1080, not 1920 — matches the mobile export guidance (390px CSS width
    // × up to ~3x device pixel ratio), so a mobile crop isn't shipping
    // desktop-sized bytes to a phone.
    const mobileSrc = media.mobileSrc ? await resolveImageSrc(media.mobileSrc, 1080) : undefined;
    slides.push({
      chapterId: section.id,
      heading,
      body,
      media: { type: "image", src, alt: media.alt[locale], mobileSrc },
    });
  } else if (media.type === "video") {
    slides.push({
      chapterId: section.id,
      heading,
      body,
      media: {
        type: "video",
        src: media.src,
        mobileSrc: media.mobileSrc,
        allowUnmute: media.allowUnmute,
      },
    });
  } else if (media.type === "videoGallery") {
    const items = await Promise.all(
      media.items.map(async (item) => {
        const poster = item.poster ? await getImage({ src: getMediaImage(item.poster), width: 1920 }) : undefined;
        const mobilePoster = item.mobilePoster
          ? await getImage({ src: getMediaImage(item.mobilePoster), width: 1080 })
          : undefined;
        return {
          src: item.src,
          mobileSrc: item.mobileSrc,
          poster: poster?.src,
          mobilePoster: mobilePoster?.src,
          allowUnmute: item.allowUnmute,
        };
      }),
    );
    items.forEach((item, i) => {
      slides.push({
        chapterId: section.id,
        heading: i === 0 ? heading : undefined,
        body: i === 0 ? body : undefined,
        media: { type: "video", ...item },
      });
    });
  } else if (media.type === "gallery") {
    const items = await Promise.all(
      media.items.map(async (item) => ({
        src: await resolveImageSrc(item.src),
        alt: item.alt,
        mobileSrc: item.mobileSrc ? await resolveImageSrc(item.mobileSrc, 1080) : undefined,
        padded: item.padded,
        background: item.background,
      })),
    );
    items.forEach((item, i) => {
      slides.push({
        chapterId: section.id,
        heading: i === 0 ? heading : undefined,
        body: i === 0 ? body : undefined,
        media: {
          type: "image",
          src: item.src,
          alt: item.alt,
          mobileSrc: item.mobileSrc,
          padded: item.padded,
          background: item.background,
        },
      });
    });
  } else if (media.type === "carousel") {
    // The large illustration/portrait/icon sets (currently only Grieg
    // Connect) render as the actual drag carousel filling the slide, not a
    // single representative image — same GalleryCarousel component used
    // elsewhere on the site, just full-bleed here instead of column-width.
    const items = await Promise.all(
      media.items.map(async (item) => ({ src: await resolveImageSrc(item.src), alt: item.alt })),
    );
    slides.push({
      chapterId: section.id,
      heading,
      body,
      media: { type: "carousel", items, shape: media.shape, colorful: media.colorful },
    });
    if (media.trailingImage) {
      const src = await resolveImageSrc(media.trailingImage.src);
      const mobileSrc = media.trailingImage.mobileSrc
        ? await resolveImageSrc(media.trailingImage.mobileSrc, 1080)
        : undefined;
      slides.push({
        chapterId: section.id,
        media: {
          type: "image",
          src,
          alt: media.trailingImage.alt,
          mobileSrc,
          padded: media.trailingImage.padded,
          background: media.trailingImage.background,
        },
      });
    }
  }
}

// The project's hero photo (if set) opens the experience as slide 0,
// replacing whatever the first section's own media would otherwise be —
// this is the exact same photo the homepage's portfolio card uses (see
// resolveCaseStudyHeroImage), so the shared-element view-transition morph
// on arrival lands <img> onto <img>. A heroVideo, if the project also has
// one, is pushed to its own slide right after, using this same photo as
// its poster — the hero is always a static image, never the video itself
// (see content.config.ts's own comment on heroImage/heroVideo). Morphing
// straight onto a <video> element read as jumpy/glitchy in practice (a
// poster-frame flash, then autoplay kicking in a beat later, sometimes
// mid-transition), where two plain images morph cleanly.
if (entry.data.heroImage && slides.length > 0) {
  const heroSrc = await resolveImageSrc(entry.data.heroImage.src);
  const heroMobileSrc = entry.data.heroImage.mobileSrc
    ? await resolveImageSrc(entry.data.heroImage.mobileSrc, 1080)
    : undefined;
  slides[0] = {
    ...slides[0],
    media: {
      type: "image",
      src: heroSrc,
      alt: entry.data.heroImage.alt[locale],
      mobileSrc: heroMobileSrc,
    },
  };
  if (entry.data.heroVideo) {
    slides.splice(1, 0, {
      chapterId: `${entry.data.sections[0].id}-video`,
      media: {
        type: "video",
        src: entry.data.heroVideo.src,
        mobileSrc: entry.data.heroVideo.mobileSrc,
        poster: heroSrc,
        mobilePoster: heroMobileSrc,
      },
    });
  }
} else if (entry.data.heroVideo && slides.length > 0) {
  // No dedicated hero photo to split it from — fall back to the video
  // replacing slide 0 directly.
  slides[0] = {
    ...slides[0],
    media: {
      type: "video",
      src: entry.data.heroVideo.src,
      mobileSrc: entry.data.heroVideo.mobileSrc,
    },
  };
}

const credits = (entry.data.credits ?? []).map((credit) => ({
  role: credit.role[locale],
  name: typeof credit.name === "string" ? credit.name : credit.name[locale],
}));

// Recognition and credits close out the chapter sequence (in that order,
// second-to-last and last) rather than living in the sidebar — see
// CaseStudyExperience's RecognitionSlide/CreditsSlide for why they're
// rendered as their own kind of slide instead of going through the
// image/video Media component every other slide uses.
if (entry.data.recognition?.length) {
  slides.push({ chapterId: "recognition", heading: t("case.recognition"), recognition: entry.data.recognition });
}
if (credits.length) {
  slides.push({ chapterId: "credits", heading: t("case.credits"), credits });
}

// Closes the experience with a single "next project" teaser instead of a
// full cross-promo carousel of every other case study — one clear next step
// rather than a whole gallery to choose from, matching the reference site's
// own minimal "Next Project" pattern. Sequential by collection order
// (getCollection's own glob order — there's no explicit ordering field in
// the schema), wrapping back to the first project after the last.
const allCaseStudies = await getCollection("case-studies");
const currentIndex = allCaseStudies.findIndex((other) => other.id === entry.id);
const nextEntry = allCaseStudies[(currentIndex + 1) % allCaseStudies.length];
const nextImage = await getImage({ src: getMediaImage(nextEntry.data.cover), width: 1600 });
const nextProject = {
  href: localizedPath(locale, `/work/${nextEntry.id}`),
  title: nextEntry.data.title[locale],
  subtitle: nextEntry.data.description[locale],
  image: nextImage.src,
  imageAlt: nextEntry.data.coverAlt[locale],
  accent: nextEntry.data.accent,
};
---

<BaseLayout
  locale={locale}
  title={`${entry.data.title[locale]} — Hinside`}
  description={entry.data.description[locale]}
  accent={entry.data.accent}
  bodyBackground="var(--color-soft-cream)"
  footerTheme="light"
  hideFooter
  caseStudyTransition
>
  <CaseStudyExperience
    client:load
    meta={{
      title: entry.data.title[locale],
      client: entry.data.client,
      clientLabel: t("case.client"),
    }}
    slides={slides}
    nextProject={nextProject}
    coverTransitionName={caseCoverTransitionName(entry.id)}
  />
</BaseLayout>
