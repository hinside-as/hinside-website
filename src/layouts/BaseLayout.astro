---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/playfair-display";
import "../styles/global.css";
// Preloaded explicitly (Vite ?url import, not just the @font-face rules the
// bare import above registers) so the browser starts fetching these two
// subsets — the only ones h1/h2/h3 text on this site actually needs — in
// parallel with HTML parsing instead of discovering them only once the
// cascade resolves font-family on a heading. font-display: swap (fontsource's
// default) still governs the fallback-to-Playfair swap itself; preloading
// just shrinks the window where that swap is visible.
import playfairLatin from "@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url";
import playfairLatinExt from "@fontsource-variable/playfair-display/files/playfair-display-latin-ext-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { useTranslations, localizedPath, type Locale } from "../i18n/utils";

const GA_MEASUREMENT_ID = "G-T7TSLX0N4S";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  accent?: string;
  /** Overrides body's own painted background (not the --color-bg token —
   * every component reading that custom property, the header's default
   * on-dark pill included, stays on the real dark value). Exists because
   * position: sticky elements still reserve their natural, un-offset flow
   * space — the site header being first in the document means that space
   * sits above <main> and paints with whatever body's own background is.
   * That was invisible while every homepage section opened dark (body's
   * default), but a page whose first section is light needs this so a
   * mismatched dark sliver doesn't show above it. */
  bodyBackground?: string;
  /** False on slide-based pages (the homepage) that drive the header's
   * visibility themselves rather than this component's own scroll-
   * direction-based show/hide. */
  headerScrollControlsVisibility?: boolean;
  footerNoBorder?: boolean;
  footerWideMargin?: boolean;
  /** See Footer.astro's own `theme` prop — a page whose content is light
   * rather than the site's dark default passes this through so the footer
   * beneath it stays readable. */
  footerTheme?: "light";
  /** Case-study pages end in their own "next project" teaser instead of the
   * site-wide footer — there's always somewhere further to scroll to, so
   * the footer's contact/social links never actually get reached anyway. */
  hideFooter?: boolean;
  /** Stamps data-case-study on <html> — see global.css's own
   * [data-case-study]::view-transition-old/new(root) rules for why this is
   * enough, on its own, to give every case-study page its own vertical
   * slide-and-fade transition (leaving OR arriving at one) instead of
   * Astro's default crossfade, with no other JS/event wiring needed. */
  caseStudyTransition?: boolean;
};

const {
  locale,
  title,
  description,
  accent,
  bodyBackground,
  headerScrollControlsVisibility = true,
  footerNoBorder = false,
  footerWideMargin = false,
  footerTheme,
  hideFooter = false,
  caseStudyTransition = false,
} = Astro.props;
const t = useTranslations(locale);
const canonicalPath = localizedPath(locale, Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath, Astro.site);

const navLinks = [
  { href: `${localizedPath(locale, "/")}#work`, label: t("nav.work") },
  { href: `${localizedPath(locale, "/")}#studio`, label: t("nav.studio") },
  { href: `${localizedPath(locale, "/")}#contact`, label: t("nav.contact") },
];
---

<!doctype html>
<html lang={locale} data-case-study={caseStudyTransition ? "true" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="no" href={new URL(localizedPath("no", Astro.url.pathname), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localizedPath("en", Astro.url.pathname), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath("no", Astro.url.pathname), Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={playfairLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={playfairLatinExt} crossorigin />
    <ClientRouter />
  </head>
  <body
    style={[accent && `--accent: ${accent};`, bodyBackground && `background: ${bodyBackground};`]
      .filter(Boolean)
      .join(" ") || undefined}
  >
    <a class="visually-hidden" href="#main-content">Skip to content</a>
    <Header
      locale={locale}
      links={navLinks}
      menuLabel={t("nav.menu")}
      closeLabel={t("nav.close")}
      otherLocaleLabel={t("lang.switchTo")}
      scrollControlsVisibility={headerScrollControlsVisibility}
    />
    <main id="main-content">
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} noBorder={footerNoBorder} wideMargin={footerWideMargin} theme={footerTheme} />}
    {
      // PROD-only, same reasoning as the old inline GA snippet this
      // replaced — no banner, no analytics machinery at all, under
      // `astro dev`.
      import.meta.env.PROD && <CookieConsent locale={locale} gaId={GA_MEASUREMENT_ID} />
    }
  </body>
</html>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (revealTargets.length > 0 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
    );
    revealTargets.forEach((el) => observer.observe(el));
  } else {
    revealTargets.forEach((el) => el.classList.add("is-revealed"));
  }

  // Scroll-linked parallax: [data-parallax="0.2"] elements drift vertically
  // relative to how far their center sits from the viewport's own center.
  // Small factor = slower/"further back", larger = faster/"closer".
  // Writes a CSS custom property rather than `transform` directly so
  // [data-reveal]'s own transform (see global.css) can compose with it
  // instead of the two fighting over the same property.
  const parallaxTargets = document.querySelectorAll<HTMLElement>("[data-parallax]");
  if (parallaxTargets.length > 0 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let ticking = false;
    const updateParallax = () => {
      const viewportHeight = window.innerHeight;
      const viewportCenter = viewportHeight / 2;
      parallaxTargets.forEach((el) => {
        const factor = parseFloat(el.dataset.parallax ?? "0");
        const rect = el.getBoundingClientRect();
        const elementCenter = rect.top + rect.height / 2;
        // Clamp the distance to one viewport height: once an element is
        // well off-screen the effect should cap out, not keep growing
        // unbounded the further the page scrolls past it.
        const distance = Math.max(-viewportHeight, Math.min(viewportHeight, elementCenter - viewportCenter));
        el.style.setProperty("--parallax-y", `${(distance * factor).toFixed(2)}px`);
      });
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateParallax);
    };
    updateParallax();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  // Case-study pages get their own root slide+fade view-transition (see
  // global.css's [data-case-study-linked] rules) instead of the default
  // crossfade — but only for a transition BETWEEN two case studies (the
  // next-project link, or the browser's back button reversing one). Either
  // side of that transition touching the homepage instead already has its
  // own motion: the portfolio card's own shared-element morph into/out of
  // the hero image (same view-transition-name on both — the browser pairs
  // them automatically regardless of how the navigation happened, back
  // button included). Running the root slide at the same time as that morph
  // read as jumpy, two independent motions competing, rather than clean —
  // so this only stamps data-case-study-linked when BOTH ends are case
  // studies, leaving every homepage-boundary crossing to the browser's own
  // plain default fade instead.
  //
  // Destination is checked by URL shape (/work/<slug>), not by waiting for
  // the fetched page's own data-case-study attribute — simpler, and it
  // needs to run twice regardless, for two different reasons: once on
  // astro:before-preparation (fires before startViewTransition captures the
  // *old* snapshot, early enough that setting the attribute on the live
  // document here actually affects it) and again on astro:before-swap
  // (fires after the swap — which overwrites the live document's own
  // attributes with the new page's — would otherwise erase it; mutating
  // the pre-swap event.newDocument instead survives that overwrite, since
  // that's exactly what gets copied onto the live document moments later).
  const isCaseStudyPath = (pathname: string) => /\/work\/[^/]+\/?$/.test(pathname);
  const updateCaseStudyLinked = (to: URL, target: HTMLElement) => {
    const linked = document.documentElement.hasAttribute("data-case-study") && isCaseStudyPath(to.pathname);
    target.toggleAttribute("data-case-study-linked", linked);
  };
  document.addEventListener("astro:before-preparation", (event) => {
    updateCaseStudyLinked(event.to, document.documentElement);
  });
  document.addEventListener("astro:before-swap", (event) => {
    updateCaseStudyLinked(event.to, event.newDocument.documentElement);
  });
</script>
