---
import BrandMark from "./BrandMark.astro";
import SiteNav, { type NavLink } from "./SiteNav.tsx";
import { localizedPath, otherLocale, type Locale } from "../i18n/utils";

type Props = {
  locale: Locale;
  links: NavLink[];
  menuLabel: string;
  closeLabel: string;
  otherLocaleLabel: string;
  /** False on slide-based pages (case studies, the homepage), which drive
   * the header's visibility themselves via --header-reveal (visible only on
   * their first slide) rather than this component's own scroll-direction-
   * based show/hide. */
  scrollControlsVisibility?: boolean;
  /** Case-study pages (not yet redesigned) want the OLD flush, square-
   * cornered, opaque-background header — edge to edge, matching the
   * sidebar/footer's own flat surface — rather than the new detached
   * floating pill every other page uses by default. */
  solidBackground?: boolean;
  /** Case-study pages' sidebar/footer use --space-5 horizontal padding
   * (wider than the site's usual --space-4) — the header's own row needs
   * the same value to stay flush with the same left edge as both. */
  wideMargin?: boolean;
};

const {
  locale,
  links,
  menuLabel,
  closeLabel,
  otherLocaleLabel,
  scrollControlsVisibility = true,
  solidBackground = false,
  wideMargin = false,
} = Astro.props;
const otherHref = localizedPath(otherLocale(locale), Astro.url.pathname);
---

<header
  class="site-header"
  data-site-header
  data-hidden="false"
  data-scroll-controls-visibility={String(scrollControlsVisibility)}
  data-solid={solidBackground ? "true" : undefined}
  data-wide-margin={wideMargin ? "true" : undefined}
>
  <div class="site-header__row">
    <div class="site-header__brand">
      <BrandMark href={localizedPath(locale, "/")} />
    </div>
    <SiteNav
      links={links}
      menuLabel={menuLabel}
      closeLabel={closeLabel}
      otherLocaleHref={otherHref}
      otherLocaleLabel={otherLocaleLabel}
      client:load
    />
  </div>
  {/* SiteNav portals its expanded mobile-menu content in here (see its own
     comment) rather than to document.body — it's normal flow content that
     grows this header's own box now, not a position:fixed overlay, so it
     stays within this same floating card instead of needing to escape it. */}
  <div id="mobile-nav-panel-target"></div>
</header>

<style>
  /* Detached floating pill (the default, every page except case studies —
     see [data-solid="true"] below): inset from the viewport on all sides
     rather than flush, so it reads as its own surface floating above the
     page instead of a bar spanning it edge to edge. backdrop-filter lives
     directly on .site-header now (not a ::before pseudo-element, as an
     earlier version needed): that indirection existed only because the
     mobile menu used to be a position: fixed panel nested inside this
     element, and backdrop-filter/transform make an element a containing
     block for any such descendant — trapping that panel inside this small
     box instead of the viewport. Now that the panel is normal in-flow
     content (see #mobile-nav-panel-target above) rather than its own
     fixed-position overlay, there's no fixed descendant left to trap, so
     the indirection is unnecessary. */
  .site-header {
    position: sticky;
    top: 24px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    /* Caps and centers at the same width as the page's own content column
       (--content-max-width, same token .hs__content uses) rather than
       just a fixed 24px inset — on an ordinary window this reads
       identically to a plain inset (viewport minus 48px is already
       narrower than the cap), but on a very wide monitor the header would
       otherwise keep stretching edge to edge while the actual content
       below it stays capped and centered, visibly wider than everything
       it's supposed to align with. */
    width: calc(100% - var(--space-4) * 2);
    max-width: var(--content-max-width);
    margin-inline: auto;
    border-radius: 8px;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    transition:
      transform var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard);
  }
  .site-header__row {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding-inline: var(--space-4);
  }
  .site-header[data-hidden="true"] {
    transform: translateY(-100%);
  }
  /* Case-study pages only: reverts every "detached pill" property above
     back to the original flush, opaque, square-cornered bar — those pages
     haven't been redesigned yet and still want their header to read as
     one continuous surface with the sidebar/footer beneath it (see
     CLAUDE.md's case-study notes on why they share one flat background
     with no border/shadow between them). transform is still driven by
     --header-reveal (see HomeExperience/CaseStudyExperience's own scroll
     effect) rather than the data-hidden flag + timed transition above —
     a fixed-duration transition triggered by a one-off flag can finish
     well after a fast scroll-snap fling has already settled, reading as
     the header lagging/bouncing into place; tying it straight to scroll
     position removes that independent timer entirely. */
  .site-header[data-solid="true"] {
    top: 0;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    border-radius: 0;
    overflow: visible;
    background: var(--color-bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    box-shadow: none;
    transition: none;
    transform: translateY(calc((var(--header-reveal, 1) - 1) * 100%));
  }
  /* Redefining --color-bg/--color-fg locally (not swapping in a whole
     separate rule set) lets every descendant that already reads those
     tokens — BrandMark's fill, SiteNav's inherited text color — adapt for
     free via normal CSS cascade, no per-component light/dark variant
     needed. Only ever set on pages whose sections declare
     [data-section-theme] (see the header's own script) — everywhere else
     this attribute never appears, so nothing changes. */
  .site-header[data-on-light="true"] {
    --color-bg: var(--color-soft-cream);
    --color-fg: var(--color-soft-black);
    --color-fg-muted: color-mix(in srgb, var(--color-soft-black) 65%, transparent);
    color: var(--color-fg);
  }
  .site-header[data-on-light="true"] {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }
  .site-header__brand {
    width: var(--brand-mark-width);
    height: var(--brand-mark-height);
    flex: 0 0 auto;
  }
  @media (min-width: 60rem) {
    .site-header[data-wide-margin="true"] .site-header__row {
      padding-inline: var(--space-5);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let lastScrollY = window.scrollY;
    const scrollControlsVisibility = header.dataset.scrollControlsVisibility !== "false";

    const onScroll = () => {
      const currentScrollY = window.scrollY;
      if (scrollControlsVisibility) {
        const isScrollingDown = currentScrollY > lastScrollY;
        header.dataset.hidden = String(isScrollingDown && currentScrollY > 160);
      }
      lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    // Adapts the header's own colour to whichever section currently sits
    // behind it — only does anything on pages that actually mark their
    // sections up with [data-section-theme] (currently just the homepage,
    // see HomeExperience.tsx); a page with none simply has nothing to
    // observe. Same center-crossing IntersectionObserver principle as
    // useActiveSection (case-study TOC) — purely observational, never
    // touches scroll itself. Distinct from the site-wide data-theme
    // light/dark-mode attribute on <html>: this is "what's behind the
    // header right now," not a user preference.
    const themedSections = document.querySelectorAll<HTMLElement>("[data-section-theme]");
    if (themedSections.length > 0) {
      const themeObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const theme = entry.target.getAttribute("data-section-theme");
            if (theme) header.dataset.onLight = String(theme === "light");
          }
        },
        { rootMargin: "-50% 0px -50% 0px", threshold: 0 },
      );
      themedSections.forEach((section) => themeObserver.observe(section));
    }

    // Native scrollIntoView, not a hand-rolled rAF easing loop — no need to
    // hand-roll scroll physics the browser already provides. Target
    // elements get their header clearance from scroll-margin-top (see
    // HomeExperience's #work/#studio/#contact) rather than a manual offset
    // calculated here.
    const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const navLinks = header.querySelectorAll<HTMLAnchorElement>("a[data-nav-hash]");
    navLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const hash = link.dataset.navHash;
        const target = hash ? document.getElementById(hash) : null;
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
      });
    });
  }
</script>
