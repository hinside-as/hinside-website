---
import BrandMark from "./BrandMark.astro";
import SiteNav, { type NavLink } from "./SiteNav.tsx";
import { localizedPath, otherLocale, type Locale } from "../i18n/utils";

type Props = {
  locale: Locale;
  links: NavLink[];
  menuLabel: string;
  closeLabel: string;
  otherLocaleLabel: string;
  /** False on slide-based pages (the homepage), which drive the header's
   * visibility themselves rather than this component's own scroll-
   * direction-based show/hide. */
  scrollControlsVisibility?: boolean;
};

const { locale, links, menuLabel, closeLabel, otherLocaleLabel, scrollControlsVisibility = true } = Astro.props;
const otherHref = localizedPath(otherLocale(locale), Astro.url.pathname);
---

<header
  class="site-header"
  data-site-header
  data-hidden="false"
  data-scroll-controls-visibility={String(scrollControlsVisibility)}
>
  <div class="site-header__row">
    <div class="site-header__brand">
      <BrandMark href={localizedPath(locale, "/")} />
    </div>
    <SiteNav
      links={links}
      menuLabel={menuLabel}
      closeLabel={closeLabel}
      otherLocaleHref={otherHref}
      otherLocaleLabel={otherLocaleLabel}
      client:load
    />
  </div>
  {/* SiteNav portals its expanded mobile-menu content in here (see its own
     comment) — position: relative makes this the positioning context for
     that panel's own position: absolute, so it overlays whatever's below
     the header instead of pushing it down the page. Not document.body:
     staying inside .site-header keeps the panel visually anchored to (and
     the same width as) the header pill, matching the Figma spec's compact
     dropdown rather than a full-screen takeover. */}
  <div id="mobile-nav-panel-target"></div>
</header>

<style>
  /* Detached floating pill, used on every page: inset from the viewport
     on all sides rather than flush, so it reads as its own surface
     floating above the page instead of a bar spanning it edge to edge.
     A translucent blurred
     black, not the flat solid color an earlier pass switched to — that
     switch was specifically to avoid backdrop-filter sampling different
     content behind it (a light section vs. one of the portfolio carousel's
     own images) and reading as two mismatched rectangles; reintroduced
     here deliberately, with that same variance now an accepted trade-off
     rather than an oversight. No box-shadow — the blur itself is what
     separates the pill from the page now, a drop shadow on top of that
     read as redundant. */
  .site-header {
    position: sticky;
    top: 24px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    /* 24px from the viewport edge on every side — left, right, and top
       (the sticky offset above) all the same flat value, capped by
       --content-max-width once the viewport gets wide enough that a plain
       24px inset would otherwise keep growing past it. --space-4 is that
       same 24px, already used for the *inner* logo-to-pill-edge gap below
       — reused here for the *outer* pill-to-viewport gap, a different
       role, same value. */
    width: calc(100% - var(--space-4) * 2);
    max-width: calc(var(--content-max-width) - var(--space-4) * 2);
    margin-inline: auto;
    border-radius: 8px;
    background: color-mix(in srgb, #000 70%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform var(--duration-base) var(--ease-standard);
  }
  .site-header__row {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    /* --space-4 is exactly 24px — the same on both sides, at every
       viewport width, on every page. */
    padding-inline: var(--space-4);
  }
  /* Positioning context for the mobile panel's own position: absolute
     (see #mobile-nav-panel in SiteNav.tsx) — deliberately the *target*
     div, not .site-header itself, so the panel anchors to exactly where
     it used to sit in normal flow (flush under the row) without needing
     to account for .site-header's own padding/border-radius. .site-header
     no longer clips overflow (see its own rule above) specifically so this
     panel can extend below the row's fixed height without being cut off —
     it carries its own background/radius/shadow now instead of relying on
     the header's shared box for that. */
  #mobile-nav-panel-target {
    position: relative;
  }
  .site-header[data-hidden="true"] {
    transform: translateY(-100%);
  }
  .site-header__brand {
    width: var(--brand-mark-width);
    height: var(--brand-mark-height);
    flex: 0 0 auto;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let lastScrollY = window.scrollY;
    const scrollControlsVisibility = header.dataset.scrollControlsVisibility !== "false";

    const onScroll = () => {
      const currentScrollY = window.scrollY;
      if (scrollControlsVisibility) {
        const isScrollingDown = currentScrollY > lastScrollY;
        header.dataset.hidden = String(isScrollingDown && currentScrollY > 160);
      }
      lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    // Native scrollIntoView, not a hand-rolled rAF easing loop — no need to
    // hand-roll scroll physics the browser already provides. Target
    // elements get their header clearance from scroll-margin-top (see
    // HomeExperience's #work/#studio/#contact) rather than a manual offset
    // calculated here.
    const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const navLinks = header.querySelectorAll<HTMLAnchorElement>("a[data-nav-hash]");
    navLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const hash = link.dataset.navHash;
        const target = hash ? document.getElementById(hash) : null;
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
      });
    });
  }
</script>
