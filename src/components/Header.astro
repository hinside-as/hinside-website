---
import BrandMark from "./BrandMark.astro";
import SiteNav, { type NavLink } from "./SiteNav.tsx";
import { localizedPath, otherLocale, type Locale } from "../i18n/utils";

type Props = {
  locale: Locale;
  links: NavLink[];
  menuLabel: string;
  closeLabel: string;
  otherLocaleLabel: string;
  /** False on slide-based pages (case studies, the homepage), which drive
   * the header's visibility themselves via --header-reveal (visible only on
   * their first slide) rather than this component's own scroll-direction-
   * based show/hide. */
  scrollControlsVisibility?: boolean;
  /** Slide-based pages want a header that always matches the surrounding
   * chrome's own flat background — never the transparent/blurred "floating"
   * look this component normally takes on once scrolled. */
  solidBackground?: boolean;
  /** Case-study pages' sidebar/footer use --space-5 horizontal padding
   * (wider than the site's usual --space-4) — the header's own logo needs
   * the same value to stay flush with the same left edge as both. */
  wideMargin?: boolean;
};

const {
  locale,
  links,
  menuLabel,
  closeLabel,
  otherLocaleLabel,
  scrollControlsVisibility = true,
  solidBackground = false,
  wideMargin = false,
} = Astro.props;
const otherHref = localizedPath(otherLocale(locale), Astro.url.pathname);
---

<header
  class="site-header"
  data-site-header
  data-hidden="false"
  data-scroll-controls-visibility={String(scrollControlsVisibility)}
  data-solid={solidBackground ? "true" : undefined}
  data-wide-margin={wideMargin ? "true" : undefined}
>
  <div class="site-header__brand">
    <BrandMark href={localizedPath(locale, "/")} />
  </div>
  <SiteNav
    links={links}
    menuLabel={menuLabel}
    closeLabel={closeLabel}
    otherLocaleHref={otherHref}
    otherLocaleLabel={otherLocaleLabel}
    client:load
  />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-4);
    background: var(--color-bg);
    transition:
      transform var(--duration-base) var(--ease-standard),
      background var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }
  /* The blur/glass layer lives on ::before rather than directly on
     .site-header. backdrop-filter (like transform or filter) makes an
     element establish a new containing block for any position:fixed
     descendant — and the mobile menu's fullscreen panel is exactly that,
     nested inside this header. Putting backdrop-filter on .site-header
     itself silently confined that panel to the header's own small box
     instead of the viewport, any time the header had scrolled even 4px
     before the menu opened (i.e. almost always) — a pseudo-element has
     no descendants of its own, so it can't break anything. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0;
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: opacity var(--duration-base) var(--ease-standard);
  }
  /* Once scrolled, the header detaches from the hero/content beneath it
     and floats above it — a blurred glass background (matching the
     mobile menu panel's own treatment) plus a soft shadow reads as
     "floating" better than a hard separator line would. */
  .site-header[data-scrolled="true"] {
    background: transparent;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
  }
  .site-header[data-scrolled="true"]::before {
    opacity: 1;
  }
  .site-header[data-hidden="true"] {
    transform: translateY(-100%);
  }
  /* Wins over [data-scrolled="true"]'s transparent/blur/shadow above —
     declared after it, same specificity, later rule takes the cascade.
     transform is driven directly by --header-reveal, a 0–1 value each
     slide-based experience (CaseStudyExperience, HomeExperience) keeps in
     sync with actual scroll position via its own scroll effect — see
     either component's own comments — rather than by the data-hidden flag
     + timed transition used on other pages. A fixed-duration transition
     triggered by a one-off data-hidden flip reads fine at normal scroll
     speed, but a fast fling can let scroll-snap settle well before that
     transition finishes, so the header keeps animating for a moment after
     the page has already stopped moving — visibly detached/bouncy. Tying
     the transform straight to scroll position removes the independent
     timer entirely: the header always sits exactly where the current
     scroll offset says it should, at any scroll speed, the same quality
     the case-study sidebar's own footer-end position:sticky release
     already has for free. transition: none is deliberate — the
     --header-reveal value itself already changes smoothly (once per
     scroll frame, tracking native scroll deceleration), so a CSS
     transition on top of that would only add a second, competing lag. */
  .site-header[data-solid="true"] {
    background: var(--color-bg);
    box-shadow: none;
    transition: none;
    transform: translateY(calc((var(--header-reveal, 1) - 1) * 100%));
  }
  .site-header[data-solid="true"]::before {
    display: none;
  }
  .site-header__brand {
    width: var(--brand-mark-width);
    height: var(--brand-mark-height);
    flex: 0 0 auto;
  }
  @media (min-width: 60rem) {
    .site-header[data-wide-margin="true"] {
      padding-inline: var(--space-5);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    let lastScrollY = window.scrollY;
    const scrollControlsVisibility = header.dataset.scrollControlsVisibility !== "false";

    const onScroll = () => {
      const currentScrollY = window.scrollY;
      header.dataset.scrolled = String(currentScrollY > 4);
      if (scrollControlsVisibility) {
        const isScrollingDown = currentScrollY > lastScrollY;
        header.dataset.hidden = String(isScrollingDown && currentScrollY > 160);
      }
      lastScrollY = currentScrollY;
    };

    window.addEventListener("scroll", onScroll, { passive: true });

    // Native scrollIntoView, not a hand-rolled rAF easing loop — the
    // homepage runs under scroll-snap-type: mandatory (see BaseLayout's
    // scrollSnap prop), and a custom scroll animation calls window.scrollTo
    // every frame with a position the browser doesn't know is "mid-
    // animation," so its own snap-correction logic fights the animation
    // for control of the scroll position, reading as stutter/glitching.
    // scrollIntoView's smooth behavior is implemented by the same engine
    // that owns scroll-snap, so it cooperates with it instead. Target
    // elements get their header clearance from scroll-margin-top (see
    // .hs__step) rather than a manual offset calculated here.
    const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const navLinks = header.querySelectorAll<HTMLAnchorElement>("a[data-nav-hash]");
    navLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const hash = link.dataset.navHash;
        const target = hash ? document.getElementById(hash) : null;
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
      });
    });
  }
</script>
