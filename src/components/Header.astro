---
import BrandMark from "./BrandMark.astro";
import SiteNav, { type NavLink } from "./SiteNav.tsx";
import { localizedPath, otherLocale, type Locale } from "../i18n/utils";

type Props = {
  locale: Locale;
  links: NavLink[];
  menuLabel: string;
  closeLabel: string;
  otherLocaleLabel: string;
  /** Static override for --header-fg (see this component's own <style>),
   * for a page whose content is uniformly one color throughout — e.g. the
   * case-study template, entirely --color-soft-cream/-black — where the
   * homepage's own per-section IntersectionObserver switch would have
   * nothing to observe (no [data-header-theme] sections exist there) and
   * would otherwise leave --header-fg at its dark-default white, wrong
   * against a light page. Server-rendered directly rather than set via
   * script, so it's correct from first paint with no flash; the homepage
   * never passes this, leaving the dynamic per-section behavior intact. */
  theme?: "light";
};

const {
  locale,
  links,
  menuLabel,
  closeLabel,
  otherLocaleLabel,
  theme,
} = Astro.props;
const otherHref = localizedPath(otherLocale(locale), Astro.url.pathname);
---

<header
  class="site-header"
  data-site-header
  data-header-theme={theme}
>
  <div class="site-header__row">
    <div class="site-header__brand">
      <BrandMark href={localizedPath(locale, "/")} />
    </div>
    <SiteNav
      links={links}
      menuLabel={menuLabel}
      closeLabel={closeLabel}
      otherLocaleHref={otherHref}
      otherLocaleLabel={otherLocaleLabel}
      client:load
    />
  </div>
</header>

<style>
  /* No pill/background anymore — the header is a transparent overlay strip
     sitting flush at the very top of the viewport, on every page. Its
     content (logo + nav — see BrandMark.astro and SiteNav.tsx, both of
     which read --header-fg instead of a hardcoded color) switches between
     black and white depending on what's currently behind it.
     mix-blend-mode: difference (the same technique EyeCursorItem uses for
     the carousel's custom cursor) was the first approach tried here, but
     confirmed via isolated testing NOT to work: mix-blend-mode does not
     blend against scrolled page content when the blending element is a
     descendant of a position: sticky/fixed ancestor (a real browser
     compositing limitation — sticky/fixed elements get their own
     compositor layer, and blend-mode can't reach across that boundary).
     EyeCursorItem's cursor only works because it's a plain, non-fixed
     absolutely-positioned element within a normal local stacking context.
     --header-fg defaults to white (the site's own dark-by-default base);
     the script below watches [data-header-theme] section markers (see
     HomeExperience.tsx) via IntersectionObserver and flips it to black
     while a light section sits under the header. */
  .site-header {
    --header-fg: var(--color-white);
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
  }
  .site-header[data-header-theme="light"] {
    --header-fg: var(--color-black);
  }
  .site-header__row {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    /* Same column every other section on the site uses (see
       HomeExperience.tsx's .hs__content) — the logo lands flush with the
       left edge of the page's main content and the nav flush with the
       right, rather than the old pill's own smaller viewport inset. */
    padding-inline: var(--space-5);
  }
  .site-header__brand {
    width: var(--brand-mark-width);
    height: var(--brand-mark-height);
    flex: 0 0 auto;
  }
</style>

<script>
  // Everything here runs per *page*, not once per full load: with
  // ClientRouter a navigation swaps in a brand-new <header>, so anything
  // bound to the header found at first load silently stops applying to it
  // (which is why the header used to behave differently depending on which
  // page you happened to arrive on first). astro:page-load fires on the
  // initial load and after every navigation.
  const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Same-page nav links: native scrollIntoView, not a hand-rolled rAF
  // easing loop — no need to hand-roll scroll physics the browser already
  // provides. Target elements get their header clearance from
  // scroll-margin-top (see HomeExperience's #work/#studio/#contact).
  // Delegated on document, once, so it covers whichever header is current.
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("[data-site-header] a[data-nav-hash]");
    if (!link) return;
    const hash = link.dataset.navHash;
    const target = hash ? document.getElementById(hash) : null;
    if (!target) return;
    event.preventDefault();
    target.scrollIntoView({ behavior: prefersReducedMotion() ? "auto" : "smooth", block: "start" });
  });

  // Switches --header-fg (see this component's own <style>) between black
  // and white based on which [data-header-theme] section (see
  // HomeExperience.tsx) currently sits under the header's own strip — only
  // present on pages that actually mark sections up (currently just the
  // homepage); resolves to nothing everywhere else, leaving the header's
  // own server-rendered theme (or the CSS default) in place.
  let themeObserver: IntersectionObserver | null = null;
  let onThemeResize: (() => void) | null = null;

  const setupHeaderTheme = () => {
    themeObserver?.disconnect();
    if (onThemeResize) window.removeEventListener("resize", onThemeResize);
    themeObserver = null;
    onThemeResize = null;

    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const themedSections = Array.from(document.querySelectorAll<HTMLElement>("[data-header-theme]"));
    if (!header || themedSections.length === 0) return;

    // Seeds the correct value synchronously, before the observer's own
    // (near-instant, but async) first callback — avoids a flash of the
    // wrong color on a normal top-of-page load. A deep link landing
    // further down the page briefly seeds the wrong value until the
    // observer corrects it on its first callback, same tradeoff every
    // IntersectionObserver-based indicator on this site already accepts
    // (see useActiveNavSection).
    const firstTheme = themedSections[0].getAttribute("data-header-theme");
    if (firstTheme) header.dataset.headerTheme = firstTheme;

    const observe = () => {
      themeObserver?.disconnect();
      // rootMargin shrinks the observed root down to a 1px line through the
      // header's vertical middle — the section crossing that line is
      // whatever's actually behind the header's text right now, so the
      // colour flips exactly as a section boundary passes the middle of
      // the header (a band the full height of the header flipped it up to
      // half a header-height too early, briefly leaving e.g. white text on
      // the still-white section).
      // Recomputed on resize since it bakes in window.innerHeight.
      const headerHeight = header.getBoundingClientRect().height;
      themeObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const theme = entry.target.getAttribute("data-header-theme");
            if (theme) header.dataset.headerTheme = theme;
          }
        },
        { rootMargin: `-${headerHeight / 2}px 0px -${window.innerHeight - headerHeight / 2 - 1}px 0px`, threshold: 0 },
      );
      themedSections.forEach((section) => themeObserver?.observe(section));
    };
    observe();
    onThemeResize = observe;
    window.addEventListener("resize", onThemeResize);
  };

  document.addEventListener("astro:page-load", setupHeaderTheme);
</script>
