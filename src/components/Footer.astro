---
import BrandMark from "./BrandMark.astro";
import { localizedPath, type Locale } from "../i18n/utils";

type Props = {
  locale: Locale;
  /** Elsewhere on the site the border is the intended separator between
   * page content and footer — a page that wants its footer to read as a
   * continuous surface with whatever's above it instead (no hairline
   * break) sets this. */
  noBorder?: boolean;
  /** Pages using --space-5 horizontal padding elsewhere (wider than the
   * site's usual --space-4) pass this so the footer's own brand mark stays
   * flush with that same left edge. */
  wideMargin?: boolean;
  /** Case-study pages are light (white/cream), not the site's dark
   * default — redefines --color-bg/-fg/-fg-muted/-border locally (same
   * cascade technique HomeExperience.tsx's own .hs__work section and
   * CaseStudyExperience.tsx's .cse use for their own light sections)
   * rather than a global theme change, so every descendant reading those
   * tokens (link colors, the border above) adapts for free. */
  theme?: "light";
};

const { locale, noBorder = false, wideMargin = false, theme } = Astro.props;

const socials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/hinside" },
  { label: "Instagram", href: "https://www.instagram.com/hinsidedesign" },
  { label: "TikTok", href: "https://www.tiktok.com/hinsidedesign" },
  { label: "YouTube", href: "https://www.youtube.com/@hinsidedesign" },
];
---

<footer
  class="site-footer"
  data-no-border={noBorder ? "true" : undefined}
  data-wide-margin={wideMargin ? "true" : undefined}
  data-theme={theme}
>
  <div class="site-footer__brand">
    <div class="site-footer__mark">
      <BrandMark href={localizedPath(locale, "/")} />
    </div>
  </div>

  <div class="site-footer__text">
    <div class="site-footer__contact">
      <a href="mailto:hei@hinside.as">hei@hinside.as</a>
      <a href="tel:+4746661240">+47 466 61 240</a>
      <a
        href="https://www.google.com/maps/search/?api=1&query=Verkstedveien+13%2C+6517+Kristiansund+N"
        target="_blank"
        rel="noopener noreferrer"
      >
        Verkstedveien 13
      </a>
      <a href="https://virksomhet.brreg.no/nb/oppslag/enheter/937170602" target="_blank" rel="noopener noreferrer">
        937 170 602 MVA
      </a>
    </div>

    <div class="site-footer__socials">
      {socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer">{social.label}</a>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
  }
  .site-footer[data-no-border="true"] {
    border-top: none;
  }
  .site-footer[data-theme="light"] {
    --color-bg: var(--color-soft-cream);
    --color-fg: var(--color-soft-black);
    --color-fg-muted: color-mix(in srgb, var(--color-soft-black) 65%, transparent);
    --color-border: var(--color-grey-300);
    color: var(--color-fg-muted);
  }
  .site-footer a {
    color: var(--color-fg);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity var(--duration-base) var(--ease-standard);
  }
  .site-footer a:hover,
  .site-footer a:focus-visible {
    opacity: 1;
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
  }
  .site-footer__mark {
    width: var(--brand-mark-width);
    height: var(--brand-mark-height);
  }
  .site-footer__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .site-footer__contact,
  .site-footer__socials {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* Contact and socials are grouped in .site-footer__text (a nested flex
     with its own, tighter gap) rather than each getting an equal 1fr grid
     column — that previously left contact stranded in the middle third of
     the row. Grouping them and pushing the group to the far end with
     justify-content:space-between reads as one cluster near the right
     edge, balancing the brand mark on the left. */
  @media (min-width: 48rem) {
    .site-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: start;
    }
    .site-footer__text {
      flex-direction: row;
      gap: var(--space-6);
    }
  }
  @media (min-width: 60rem) {
    .site-footer[data-wide-margin="true"] {
      padding-inline: var(--space-5);
    }
  }
</style>
