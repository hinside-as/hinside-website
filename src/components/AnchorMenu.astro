---
type Props = {
  items: { id: string; label: string }[];
};

const { items } = Astro.props;
---

<nav class="anchor-menu" data-anchor-menu aria-label="Sections">
  <ul>
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} data-anchor-link={item.id}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .anchor-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .anchor-menu a {
    display: inline-block;
    text-decoration: none;
    color: var(--color-fg-muted);
    font-size: var(--text-sm);
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .anchor-menu a[data-active="true"] {
    color: var(--accent, var(--color-fg));
  }
</style>

<script>
  const menus = document.querySelectorAll<HTMLElement>("[data-anchor-menu]");

  menus.forEach((menu) => {
    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>("[data-anchor-link]"));
    const sections = links
      .map((link) => document.getElementById(link.dataset.anchorLink ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    if (sections.length === 0) return;

    const setActive = (id: string) => {
      links.forEach((link) => {
        link.dataset.active = String(link.dataset.anchorLink === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length === 0) return;
        const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
        setActive(topMost.target.id);
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  });
</script>
