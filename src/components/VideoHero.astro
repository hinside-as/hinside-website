---
import { Image } from "astro:assets";

type Props = {
  videoSrc: string;
  poster: ImageMetadata;
  posterAlt: string;
};

const { videoSrc, poster, posterAlt } = Astro.props;
---

<div class="video-hero" data-video-hero>
  <Image src={poster} alt={posterAlt} widths={[640, 1024, 1600]} sizes="100vw" class="video-hero__poster" />
  <video
    class="video-hero__video"
    src={videoSrc}
    poster={poster.src}
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  />
</div>

<style>
  .video-hero {
    position: relative;
    width: 100%;
    /* Wide, cinematic crop rather than a full 16:9 panel — fills the
       width but only about half the viewport height, cropping the
       source top/bottom. */
    height: 50vh;
    min-height: 20rem;
    max-height: 34rem;
    overflow: hidden;
    background: var(--color-bg-raised);
  }
  .video-hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }
  .video-hero[data-video-playing="true"] .video-hero__video {
    opacity: 1;
  }
</style>

<script>
  const heroes = document.querySelectorAll<HTMLElement>("[data-video-hero]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  heroes.forEach((hero) => {
    const video = hero.querySelector("video");
    if (!video) return;

    if (prefersReducedMotion) {
      // Leave the static poster in place — no autoplaying motion.
      return;
    }

    const onPlaying = () => {
      hero.dataset.videoPlaying = "true";
    };
    video.addEventListener("playing", onPlaying);
    video.play().catch(() => {
      // Autoplay can be blocked (e.g. data-saver mode) — poster stays visible.
    });
  });
</script>
