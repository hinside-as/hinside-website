---
import { HINSIDE_MARK_SLATS, VIEWBOX_WIDTH, VIEWBOX_HEIGHT } from "../lib/hinside-mark-geometry";

type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a class="brand-mark" href={href} aria-label="hinside">
  <svg
    class="brand-mark__svg"
    viewBox={`0 0 ${VIEWBOX_WIDTH} ${VIEWBOX_HEIGHT}`}
    preserveAspectRatio="xMidYMid meet"
    shape-rendering="crispEdges"
    fill="none"
    aria-hidden="true"
  >
    {HINSIDE_MARK_SLATS.map((slat) => (
      <rect x={slat.x} y={slat.y} width={slat.w} height="1" />
    ))}
  </svg>
</a>

<style>
  .brand-mark {
    display: block;
    width: 100%;
  }
  .brand-mark__svg {
    display: block;
    width: 100%;
    height: auto;
  }
  /* --header-fg is set on .site-header (see Header.astro) and switches
     black/white per section as the page scrolls — mix-blend-mode was the
     first approach tried here but confirmed not to work across a
     position: sticky boundary (see Header.astro's own comment). Falls
     back to the ordinary --color-fg token when this mark is used outside
     the header (Footer.astro), where no such switching applies. Dimmed
     via the fill's own alpha (color-mix against transparent) rather than
     the opacity property, purely to match the rest of the header's hover
     treatment. */
  .brand-mark__svg rect {
    fill: color-mix(in srgb, var(--header-fg, var(--color-fg)) 70%, transparent);
    transition: fill var(--duration-base) var(--ease-standard);
  }
  .brand-mark:hover .brand-mark__svg rect,
  .brand-mark:focus-visible .brand-mark__svg rect {
    fill: var(--header-fg, var(--color-fg));
  }
</style>
